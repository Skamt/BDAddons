{
	"name": "BDStuff",
	"version": "3.0.0",
	"scripts": {
		"dist": "node builder/index.js build && node builder/index.js build -d",
		"build": "node builder/index.js build",
		"build:a": "node builder/index.js build -a",
		"build:w": "node builder/index.js build -w",
		"dev": "node builder/index.js build -d",
		"dev:w": "node builder/index.js build -dw",
		"dev:a": "node builder/index.js build -a",
		"all": "node builder/index.js build -a && node builder/index.js build -da",
		"new": "node builder/index.js new",
		"lint": "eslint %INIT_CWD%/**",
		"list": "node builder/index.js list"
	},
	"keywords": [],
	"author": "Skamt",
	"license": "ISC",
	"description": "Collection of my BetterDiscord plugins",
	"dependencies": {
		"commander": "^15.0.0",
		"esbuild": "^0.28.2",
		"esbuild-plugin-import-glob": "^0.1.1",
		"js-beautify": "^2.0.3"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.20.5",
		"@eslint/js": "^10.0.1",
		"deep-object-diff": "^1.1.9",
		"eslint": "^10.11.0",
		"globals": "^17.12.0"
	},
	"allowScripts": {
		"esbuild": false
	}
}
